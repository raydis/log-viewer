# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Export ignore for composer releases (keep package zip small and clean)
/.github export-ignore
/.git export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/tests export-ignore
phpunit.xml export-ignore
