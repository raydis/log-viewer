{
    "name": "raytech/raytech-log-viewer",
    "description": "Ready-to-use modern log viewer plugin for all Laravel and server logs with theme customization, live AJAX refresh, instant search, and zero database setup.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "log-viewer",
        "logs",
        "raytech",
        "server-logs",
        "wamp",
        "apache",
        "php-error-log",
        "error-log"
    ],
    "authors": [
        {
            "name": "RayTech",
            "email": "dev@raytech.local"
        }
    ],
    "require": {
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/view": "^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Raytech\\LogViewer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Raytech\\LogViewer\\RaytechLogViewerServiceProvider"
            ],
            "aliases": {
                "RaytechLogViewer": "Raytech\\LogViewer\\Facades\\RaytechLogViewer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
