{
    "name": "raytech/raytech-log-viewer",
    "description": "Ready-to-use modern log viewer plugin for all Laravel and server logs with theme customization, live AJAX refresh, instant search, and zero database setup.",
    "homepage": "https://github.com/raytech-us/log-viewer",
    "support": {
        "issues": "https://github.com/raytech-us/log-viewer/issues",
        "source": "https://github.com/raytech-us/log-viewer"
    },
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-log-viewer",
        "laravel-logs",
        "laravel-package",
        "laravel-plugin",
        "log-viewer",
        "logs",
        "logging",
        "logger",
        "log-reader",
        "log-manager",
        "log-analyzer",
        "monolog",
        "tail",
        "log-tail",
        "real-time-logs",
        "live-logs",
        "monitoring",
        "debugging",
        "debug",
        "diagnostics",
        "error-log",
        "error-tracker",
        "exceptions",
        "stack-trace",
        "php-error-log",
        "server-logs",
        "apache",
        "nginx",
        "php",
        "wamp",
        "laragon",
        "xampp",
        "dev-tools",
        "developer-tools",
        "raytech"
    ],
    "authors": [
        {
            "name": "RayTech",
            "email": "dev@raytech.local"
        }
    ],
    "require": {
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/view": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Raytech\\LogViewer\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Raytech\\LogViewer\\RaytechLogViewerServiceProvider"
            ],
            "aliases": {
                "RaytechLogViewer": "Raytech\\LogViewer\\Facades\\RaytechLogViewer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}